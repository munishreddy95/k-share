PUBLIC_HOST=0.0.0.0
PUBLIC_PORT=4444
AGENT_PATH=/agent
PUBLIC_BASE=https://{slug}.share.example.com
BASE_DOMAIN=share.example.com
SECURE_COOKIES=true
REQUEST_TIMEOUT_MS=120000
MAX_FRAME_BYTES=2097152

# Optional tiny-url integration. When configured, relay returns the tiny URL
# to Android and keeps the full share URL as the redirect target.
# Docker default: relay reaches tiny-url through the private flux-fileshare network.
# Use http://127.0.0.1:4100/api/links only when relay runs directly on the VPS.
TINY_URL_API_URL=http://flux-tiny-url:4100/api/links
TINY_URL_CREATE_TOKEN=change-this-same-long-random-token-as-tiny-url
TINY_URL_TTL_SECONDS=86400
TINY_URL_TIMEOUT_MS=3000
