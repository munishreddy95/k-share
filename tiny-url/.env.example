HOST=0.0.0.0
PORT=4100
PUBLIC_BASE=https://tiny.munishkumarm.com
DATA_FILE=/data/links.json

# Required in production. Relay uses this as a bearer token when creating links.
CREATE_TOKEN=change-this-same-long-random-token-as-relay

# Keep false. Relay should create links through the API; public users should not.
ALLOW_PUBLIC_CREATE=false
ENABLE_CREATE_UI=false

# Keep empty when Nginx blocks public /api/ and CREATE_TOKEN is required.
# Set exact IPs only if you know the relay source IP; Docker bridge IPs may change.
CREATE_ALLOWED_IPS=

SLUG_LENGTH=7
REDIRECT_STATUS=302
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_CREATES=30
MAX_URL_LENGTH=4096
MAX_TTL_SECONDS=31536000
