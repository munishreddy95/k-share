{
  "manifest_version": 3,
  "name": "K-Share",
  "version": "0.1.0",
  "description": "Share selected browser files through K-Share Live without the desktop app.",
  "action": {
    "default_title": "K-Share",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "notifications",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://share.fv.munishkumarm.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://share.fv.munishkumarm.com wss://share.fv.munishkumarm.com"
  }
}
